# Compressed RAM swap (see fstab.zram). Harmless when the kernel has no zram: swapon_all only logs an error.

on fs
    # lz4 is much cheaper than the default lzo on the A53; the algorithm can only be chosen before disksize is set
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /vendor/etc/fstab.zram
